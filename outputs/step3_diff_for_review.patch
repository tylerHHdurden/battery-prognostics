+        _TYPICAL_UNSEEN_MAE = float(pd.read_csv(p)["family_lodo_mae_corrected"].median()) if p.exists() else float("nan")
+    return _TYPICAL_UNSEEN_MAE if _TYPICAL_UNSEEN_MAE == _TYPICAL_UNSEEN_MAE else None
